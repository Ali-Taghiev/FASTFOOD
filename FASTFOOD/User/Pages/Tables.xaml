<UserControl x:Class="FASTFOOD.User.Pages.Tables"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FASTFOOD.User.Pages"
             xmlns:components="clr-namespace:FASTFOOD.User.Components"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="59*"/>
            <RowDefinition Height="166*"/>
        </Grid.RowDefinitions>
        <ItemsControl x:Name="numberButtonItems" ItemsSource="{Binding numberButtonItems}">
            <!-- ... -->
            <DataTemplate>
                <components:Table_Button Padding="5" Margin="39,37,0,0" Loaded="Table_Button_Loaded" Grid.RowSpan="2" HorizontalAlignment="Left" Width="300" Height="200" VerticalAlignment="Top">
                    <components:Table_Button.DataContext>
                        <Binding Path="Key"/>
                    </components:Table_Button.DataContext>
                </components:Table_Button>
            </DataTemplate>
            <!-- ... -->
        </ItemsControl>

        <Grid.BitmapEffect>
            <DropShadowBitmapEffect Color="Black" Direction="0" Softness="1" ShadowDepth="0" Opacity="0.2" />
        </Grid.BitmapEffect>
    </Grid>
</UserControl>
