<Window x:Class="FASTFOOD.User.settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FASTFOOD.User"
        mc:Ignorable="d"
        Title="Configuración" Height="450" Width="800" MinHeight="450" MinWidth="550" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen">
    <Grid>
        <TabControl TabStripPlacement="Top" 
                    SelectionChanged="TabControl_SelectionChanged"
                    x:Name="SettingsTabControl">
            <TabItem Header="General">
                <Grid>
                    <TextBlock FontWeight="Bold" Text="Restaurant Name" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0"/>
                    <TextBox  x:Name="restaurant" Margin="10,31,0,0" HorizontalAlignment="Left" Width="120" Height="24" VerticalAlignment="Top"/>
                </Grid>
            </TabItem>
            <TabItem Header="Users" Name="users" Height="20" VerticalAlignment="Top" >
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30*"/>
                        <ColumnDefinition Width="100*"/>
                    </Grid.ColumnDefinitions>

                    <Border VerticalAlignment="Top" HorizontalAlignment="Left" Grid.Column="0" Padding="10">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" FontSize="18" TextWrapping="Wrap">User Management</TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="7">Configure the users who have access to the application.</TextBlock>
                            <Button x:Name="userCreate"  Background="#FF53C753" Foreground="White" BorderBrush="#FF53C753" Click="userCreate_Click" Margin="0,5" Content="Create User"/>
                            <Button x:Name="userModify"  Background="#FF53C753" Foreground="White" BorderBrush="#FF53C753" Click="userModify_Click" IsEnabled="False" Margin="0,5" Content="Update User"/>
                            <Button x:Name="userDelete"  Background="#FF53C753" Foreground="White" BorderBrush="#FF53C753" Click="userDelete_Click" IsEnabled="False" Margin="0,5" Content="Delete User"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Padding="20">
                        <DataGrid Name="DataGridUsers" IsReadOnly="True" ColumnWidth="100*" CanUserAddRows="False" SelectionUnit="FullRow" SelectionMode="Single" SelectionChanged="DataGridUsers_SelectionChanged">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="Blue"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>
                    </Border>
                </Grid>

            </TabItem>
            <TabItem Header="About..." >

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40*"/>
                        <RowDefinition Height="50*"/>
                    </Grid.RowDefinitions>
                    <TextBlock FontFamily="/FastFood;component/Resources/#Contrail One" FontSize="34" FontWeight="Bold" VerticalAlignment="Top" HorizontalAlignment="Center" Grid.Row="1">
                        <Image Source="/FASTFOOD;component/User/logo.png" Height="36" />FastFood</TextBlock>

                    <TextBlock Grid.Row="1" FontSize="14"  FontWeight="Bold" VerticalAlignment="Top" HorizontalAlignment="Left" Height="22" Margin="284,52,0,0">Created By Ali Taghiev 
                          <Hyperlink NavigateUri="https://github.com/Ali-Taghiev" RequestNavigate="Hyperlink_RequestNavigate">GitHub</Hyperlink>
                          <Hyperlink NavigateUri="www.linkedin.com/in/ali-taghiev-b5a3312a3" RequestNavigate="Hyperlink_RequestNavigate">LinkedIn</Hyperlink>

                    </TextBlock>
                    <TextBlock x:Name="version" FontSize="10" VerticalAlignment="Bottom" HorizontalAlignment="Right" Grid.Row="1" Margin="0,0,7,3">Version</TextBlock>
                    <Rectangle Fill="#FF53C753" Grid.Row="1" Height="20" Stroke="#FF53C753" Panel.ZIndex="-1" VerticalAlignment="Bottom"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>